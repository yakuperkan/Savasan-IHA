#!/usr/bin/env bash
# Preset: stable (balanced)
# Usage: source 02_Ana_Sistem_CPP/config/deepstream/presets/stable.env

export SAVASAN_TRACKER_PROFILE=auto
export SAVASAN_TRACKER_AUTO_RESTART=1

# Recommendation thresholds
export SAVASAN_AUTO_AGGRESSIVE_SPEED_MPS=12.0
export SAVASAN_AUTO_CALM_SPEED_MPS=5.0
export SAVASAN_AUTO_AGGRESSIVE_JITTER=0.15
export SAVASAN_AUTO_CALM_JITTER=0.08

# Timing
export SAVASAN_AUTO_RECOMMEND_COOLDOWN_SEC=10
export SAVASAN_AUTO_WATCH_LOG_INTERVAL_SEC=3
export SAVASAN_AUTO_RESTART_MIN_DWELL_SEC=8
export SAVASAN_AUTO_RESTART_COOLDOWN_SEC=15

# Health checks
export SAVASAN_AUTO_PRECHECK_MAX_JITTER=0.25
export SAVASAN_AUTO_PRECHECK_MAX_COMM_FAILS=2
export SAVASAN_AUTO_POSTCHECK_TIMEOUT_SEC=5

# Fail-safe
export SAVASAN_AUTO_MAX_RESTARTS=5
export SAVASAN_AUTO_MAX_CONSECUTIVE_FAILS=3
export SAVASAN_AUTO_MAX_FAILS_IN_WINDOW=4
export SAVASAN_AUTO_FAIL_WINDOW_SEC=90
