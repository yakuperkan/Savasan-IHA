#!/usr/bin/env bash
# Preset: aggressive_mission (competition-focused)
# Usage: source 02_Ana_Sistem_CPP/config/deepstream/presets/aggressive_mission.env

export SAVASAN_TRACKER_PROFILE=auto
export SAVASAN_TRACKER_AUTO_RESTART=1

# Recommendation thresholds
export SAVASAN_AUTO_AGGRESSIVE_SPEED_MPS=10.0
export SAVASAN_AUTO_CALM_SPEED_MPS=7.0
export SAVASAN_AUTO_AGGRESSIVE_JITTER=0.12
export SAVASAN_AUTO_CALM_JITTER=0.06

# Timing
export SAVASAN_AUTO_RECOMMEND_COOLDOWN_SEC=5
export SAVASAN_AUTO_WATCH_LOG_INTERVAL_SEC=2
export SAVASAN_AUTO_RESTART_MIN_DWELL_SEC=4
export SAVASAN_AUTO_RESTART_COOLDOWN_SEC=8

# Health checks
export SAVASAN_AUTO_PRECHECK_MAX_JITTER=0.20
export SAVASAN_AUTO_PRECHECK_MAX_COMM_FAILS=1
export SAVASAN_AUTO_POSTCHECK_TIMEOUT_SEC=4

# Fail-safe
export SAVASAN_AUTO_MAX_RESTARTS=8
export SAVASAN_AUTO_MAX_CONSECUTIVE_FAILS=2
export SAVASAN_AUTO_MAX_FAILS_IN_WINDOW=3
export SAVASAN_AUTO_FAIL_WINDOW_SEC=60
