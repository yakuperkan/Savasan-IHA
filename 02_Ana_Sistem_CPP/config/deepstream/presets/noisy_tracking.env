#!/usr/bin/env bash
# Preset: noisy_tracking (challenging/noisy scenes)
# Usage: source 02_Ana_Sistem_CPP/config/deepstream/presets/noisy_tracking.env

export SAVASAN_TRACKER_PROFILE=auto
export SAVASAN_TRACKER_AUTO_RESTART=1

# Recommendation thresholds
export SAVASAN_AUTO_AGGRESSIVE_SPEED_MPS=15.0
export SAVASAN_AUTO_CALM_SPEED_MPS=4.0
export SAVASAN_AUTO_AGGRESSIVE_JITTER=0.30
export SAVASAN_AUTO_CALM_JITTER=0.15

# Timing
export SAVASAN_AUTO_RECOMMEND_COOLDOWN_SEC=15
export SAVASAN_AUTO_WATCH_LOG_INTERVAL_SEC=4
export SAVASAN_AUTO_RESTART_MIN_DWELL_SEC=12
export SAVASAN_AUTO_RESTART_COOLDOWN_SEC=20

# Health checks
export SAVASAN_AUTO_PRECHECK_MAX_JITTER=0.40
export SAVASAN_AUTO_PRECHECK_MAX_COMM_FAILS=5
export SAVASAN_AUTO_POSTCHECK_TIMEOUT_SEC=8

# Fail-safe
export SAVASAN_AUTO_MAX_RESTARTS=10
export SAVASAN_AUTO_MAX_CONSECUTIVE_FAILS=4
export SAVASAN_AUTO_MAX_FAILS_IN_WINDOW=6
export SAVASAN_AUTO_FAIL_WINDOW_SEC=120
