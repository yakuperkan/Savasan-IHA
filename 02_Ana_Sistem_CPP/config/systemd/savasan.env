# Binary yolu (install.sh gunceller; build-app oncelikli)
SAVASAN_BINARY=/home/nvidia/Savasan_IHA_Workspace/02_Ana_Sistem_CPP/build-app/savasan_iha
NVDS_ENABLE_LATENCY_MEASUREMENT=1
NVDS_ENABLE_COMPONENT_LATENCY_MEASUREMENT=1
SAVASAN_COMPONENT_LATENCY_PROFILER=1

SAVASAN_PHASE=phase5
# phase5: hybrid (varsayilan) veya baseline — argv'de hybrid/baseline yoksa burasi kullanilir
SAVASAN_LOCK_MODE=baseline
# Sartname kilit toleransi: 4 sn streak icinde max ara kayip (ms), baslangic/bitis haric
SAVASAN_LOCK_INTERIOR_BAD_MS=200
# HUD grace tahmini (sayac koruma yalnizca INTERIOR_BAD_MS ile; ~6 kare @30fps, ~12 @60fps)
SAVASAN_LOCK_GRACE_MISS_FRAMES=18
SAVASAN_LOCK_AV_MARGIN_NORM=0.05
SAVASAN_CAMERA=usb
# display=HDMI/nv3dsink + HUD | bos=headless (yalniz UDP, monitör kapali)
SAVASAN_DISPLAY=display
SAVASAN_RUN_SECONDS=0
# YOLO26 FP16 1280 (varsayilan uretim). INT8 test: config_infer_primary_yolo26s_int8_qdq.txt
SAVASAN_PGI_CONFIG=/home/nvidia/Savasan_IHA_Workspace/02_Ana_Sistem_CPP/config/deepstream/config_infer_primary.txt
SAVASAN_ALC_DEVICE=/dev/ttyACM0
SAVASAN_ALC_BAUD=115200
# AlpaguLink RF hub (C++ yazar, Python okur) — ACM0 cakismasi yok
SAVASAN_ALC_HUB_FILE=/tmp/savasan_alc_hub.env
SAVASAN_LOCK_STATE_FILE=/tmp/savasan_lock.state
SAVASAN_ALC_UPLINK_FILE=/tmp/savasan_alc_uplink.bin
SAVASAN_RFD_PORT=/dev/ttyUSB0
SAVASAN_RFD_BAUD=57600
# 1=AlpaguLink RF köprüsünü savasan-airlock ile ayni cgroup'ta baslat
SAVASAN_ALPAGULINK_ENABLE=1
# Lock paket protokolu: 1=legacy (x,y + XOR), 2=v2 (track_id + seq + ts + CRC16)
SAVASAN_ALC_LOCK_PACKET_VERSION=1
# No-lock checksum: xor (yeni) veya legacy_ff (eski firmware uyumlulugu)
SAVASAN_ALC_NOLOCK_CHECKSUM_MODE=xor
SAVASAN_ALC_HEARTBEAT=0
SAVASAN_ALC_MIN_INTERVAL_MS=75
SAVASAN_ALC_RECONNECT_INTERVAL_MS=1000
# USB kamera kopmasinda pipeline yeniden acma (varsayilan acik; kapat: SAVASAN_USB_RECONNECT=0)
SAVASAN_USB_RECONNECT=1
SAVASAN_USB_RECONNECT_MAX_ATTEMPTS=5
SAVASAN_USB_RECONNECT_INTERVAL_MS=2000
# Healthcheck pipeline FPS (/tmp/savasan_pipeline_stats.env)
SAVASAN_HEALTHCHECK_MIN_FPS=8
SAVASAN_HEALTHCHECK_STATS_STALE_SEC=15
SAVASAN_SEND_ONLY_ON_LOCK=1
SAVASAN_EVASION_ENABLE=0
# Seyir Modu: tek güdüm yolu (APF + telemetri + görsel KP)
SAVASAN_SEYIR_TX_ENABLE=0
SAVASAN_RIVAL_POOL_FILE=/tmp/savasan_rival_pool.env
SAVASAN_HSS_RF_FILE=/tmp/savasan_hss_rf.env
SAVASAN_BOUNDARY_RF_FILE=/tmp/savasan_boundary_rf.env
SAVASAN_GOTO_FILE=/tmp/savasan_goto.env
# Haritadan tıklanan nokta (RF 0x2A). 0 = kapat.
SAVASAN_SEYIR_GOTO_ENABLE=1
# SAVASAN_SEYIR_COORD_FORMAT=int32|float32 (varsayılan float32, PDF)
# SAVASAN_SEYIR_CRUISE_MPS=20
# SAVASAN_SEYIR_PITCH_DEG=8
# SAVASAN_SEYIR_SPEED_PCT=45
SAVASAN_GUIDANCE_MODE=seyir
SAVASAN_CONTROL_HZ=20
SAVASAN_SETPOINT_TX_ENABLE=0
SAVASAN_CONTROL_LOG_ENABLE=1
SAVASAN_STATE_TELEMETRY_WEIGHT=0.70
SAVASAN_STATE_VISION_WEIGHT=0.30
SAVASAN_STATE_VELOCITY_ALPHA=0.35
SAVASAN_STATE_INNOVATION_GATE_MPS=8.0
SAVASAN_STATE_YAW_ALPHA=0.30
SAVASAN_STATE_YAW_GATE_DPS=45.0
# Tracker profile: default|calm|aggressive|auto (stable bir preset adidir, profil degil)
SAVASAN_TRACKER_PROFILE=default
SAVASAN_TRACKER_AUTO_RESTART=0
# Tracker: 0=acik (tracker-driven profil). Gecici kapama: SAVASAN_TRACKER_DISABLE=1
SAVASAN_TRACKER_DISABLE=0
# Auto-profile tuning (opsiyonel; bos birakilirsa kod defaultlari kullanilir)
SAVASAN_AUTO_AGGRESSIVE_SPEED_MPS=12.0
SAVASAN_AUTO_CALM_SPEED_MPS=5.0
SAVASAN_AUTO_AGGRESSIVE_JITTER=0.15
SAVASAN_AUTO_CALM_JITTER=0.08
SAVASAN_AUTO_RESTART_MIN_DWELL_SEC=8
SAVASAN_AUTO_RESTART_COOLDOWN_SEC=15
SAVASAN_AUTO_PRECHECK_MAX_JITTER=0.25
SAVASAN_AUTO_PRECHECK_MAX_COMM_FAILS=2
SAVASAN_AUTO_MAX_CONSECUTIVE_FAILS=3
SAVASAN_AUTO_MAX_FAILS_IN_WINDOW=4
SAVASAN_AUTO_FAIL_WINDOW_SEC=90
# --- Gudum okluzyon (YOLO kacirmasinda son komutu koru) ---
# USB (BRIO): cihaz yolu; exposure/gain/WB parlaklik -> camera_profiles/*.env
SAVASAN_V4L2_DEVICE=/dev/video0
# Yarisma gunu kamera profili (savasan-run once yukler, sonra setup_usb_camera.sh uygular)
# USB BRIO + nvvidconv/VIC uyumu icin varsayilan 0 (jetson-default); SURFACE_ARRAY=4 sorunlu olabilir
SAVASAN_NVBUF_MEM_TYPE=0
# UDP + Jetson kayit: /etc/savasan/stream_common.env (AIR_LOCK + Kamikaze ortak)

# --- Mission: AIR_LOCK (LOCK-only workspace) ---
# Opsiyonel: SAVASAN_MISSION_MODE_FILE ile dosyadan mod satırı (yalnızca air_lock|lock).
SAVASAN_MISSION_MODE=air_lock
SAVASAN_MISSION_MODE_FILE=/tmp/savasan_mission.cmd
SAVASAN_MISSION_MODE_POLL_MS=250

# --- Yarışma (RF). SIHA HTTP Jetson'da yok; yer istasyonu basar. ---
SAVASAN_COMPETITION_TAKIM_NO=0
# Hub 0x01 hedef pikseli olcegi (yer SIHA paketi icin)
SAVASAN_COMPETITION_FRAME_W=800
SAVASAN_COMPETITION_FRAME_H=600
SAVASAN_CAMERA_PROFILE=outdoor_sunny
SAVASAN_CAMERA_PROFILE_DIR=/etc/savasan/camera_profiles
