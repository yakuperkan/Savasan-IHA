[Unit]
Description=x11vnc — mevcut GNOME masaustunu (:0) paylas
After=graphical.target gdm.service
Wants=graphical.target

[Service]
Type=simple
User=nvidia
Group=nvidia
Environment=DISPLAY=:0
# GDM oturumunun Xauthority dosyasi (autologin)
ExecStartPre=/usr/local/bin/savasan-wait-for-display.sh /run/user/1000/gdm/Xauthority :0 180
ExecStart=/usr/bin/x11vnc -display :0 -auth /run/user/1000/gdm/Xauthority -forever -noxdamage -repeat -shared -rfbauth /home/nvidia/.vnc/passwd -rfbport 5900 -o /var/log/savasan/x11vnc.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
