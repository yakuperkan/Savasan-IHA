# Ortak yayin + kayit (AIR_LOCK + Kamikaze). systemd: once bu, sonra savasan.env / kamikaze.env
# Kurulum: sudo cp .../stream_common.env /etc/savasan/

# --- UDP (OSD'li H265 -> yer istasyonu) ---
# Coklu alici: virgulle ayrilmis IP listesi -> multiudpsink (encode bir kez, paket
# tum clients'a cogaltilir). Tek IP de gecerli (udpsink). "ip" veya "ip:port".
SAVASAN_UDP_ENABLE=1
SAVASAN_UDP_HOST=192.168.1.10,192.168.1.101
SAVASAN_UDP_PORT=5000
SAVASAN_UDP_CODEC=h265
SAVASAN_UDP_BITRATE=4000000
SAVASAN_INGEST_FPS=30

# --- Jetson MP4 kayit (OSD'li H264; UDP ile paralel tee) ---
# Sartname: workspace/output altina flight_output_YYYYMMDD_HHMMSS.mp4
SAVASAN_RECORD_ENABLE=1
SAVASAN_RECORD_DIR=/home/nvidia/Savasan_IHA_Workspace/output
SAVASAN_RECORD_EXT=mp4
